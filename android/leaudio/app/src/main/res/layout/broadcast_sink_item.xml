<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/broadcast_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Broadcast Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/broadcast_id_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: 0"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/broadcast_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Details"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/add_source_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Source"
                android:layout_marginEnd="4dp"
                style="@android:style/Widget.Button.Small" />

            <Button
                android:id="@+id/join_source_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@android:style/Widget.Button.Small" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/update_source_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Update"
                android:layout_marginEnd="4dp"
                style="@android:style/Widget.Button.Small" />

            <Button
                android:id="@+id/leave_source_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Leave"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@android:style/Widget.Button.Small" />

            <Button
                android:id="@+id/remove_source_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Remove"
                android:layout_marginStart="4dp"
                style="@android:style/Widget.Button.Small" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
