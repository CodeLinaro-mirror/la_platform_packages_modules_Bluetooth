package: "com.android.bluetooth.flags"
container: "com.android.btservices"

flag {
    name: "nrpa_non_connectable_adv"
    namespace: "bluetooth"
    description: "Use NRPA for non-connectable advertising with public address policy."
    bug: "319511126"
}

flag {
    name: "specific_scan_channel"
    namespace: "bluetooth"
    is_exported: true
    description: "Use specific scan channel"
    bug: "<none>"
}
