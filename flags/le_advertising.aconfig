package: "com.android.bluetooth.flags"
container: "com.android.bt"

flag {
    name: "nrpa_non_connectable_adv"
    namespace: "bluetooth"
    description: "Use NRPA for non-connectable advertising with public address policy."
    bug: "319511126"
}

flag {
    name: "pawr_advertiser_extension"
    is_exported: true
    namespace: "bluetooth"
    description: "Enable PAwR advertiser-side extensions"
    bug: "<none>"
}
